# Sets Premium playback attributes, disables supported ads and shuffle restrictions, and adjusts mobile API requests.
# Self-contained scripts; no remote JavaScript downloads.
name = Spotify Premium
hostname = spclient.wg.spotify.com, spotify.com

[Rule]
0,2,^https?://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/user-customization-service/v1/customize(?:\?|$),If-None-Match
0,0,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/((?:artistview/v1/artist|album-entity-view/v2/album)/[^#]*?)([?&])platform=iphone(?=&|$)(.*)$,0,https://$1/$2$3platform=ipad$4
0,0,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com):443/((?:artistview/v1/artist|album-entity-view/v2/album)/.*)$,0,https://$1/$2
0,0,^http://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/((?:artistview/v1/artist|album-entity-view/v2/album)/[^#]*?)([?&])platform=iphone(?=&|$)(.*)$,0,http://$1/$2$3platform=ipad$4
0,0,^http://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com):443/((?:artistview/v1/artist|album-entity-view/v2/album)/.*)$,0,http://$1/$2
0,0,^https?://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(?:ad-logic|ads)(?:[/?]|$),2,
# Source: scripts/spotify-premium.js
1,100,^https?://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(?:bootstrap/v1/bootstrap|user-customization-service/v1/customize)(?:\?|$),
