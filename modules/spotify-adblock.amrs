# Experimental Spotify ad blocking with a smaller set of Premium account flags and optional service blocking.
# Self-contained scripts; no remote JavaScript downloads.
name = Spotify Ad Block Trial
hostname = spclient.wg.spotify.com, spotify.com

[Rule]
# Source: scripts/spotify-adblock-services.js
0,100,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(pendragon|pushka-tokens|gabo-receiver-service|ad(?:s|-logic)?|offline)(?:[/?]|$),
# Source: scripts/spotify-adblock.js
1,100,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(?:bootstrap/v1/bootstrap|user-customization-service/v1/customize)(?:\?|$),

[Parameter]
1,0,blockServices,Block extra service endpoints,"Return local responses for selected ad, pendragon, gabo, pushka, and offline endpoints. Turn off to compare playback.",true,"[true, false]"
1,0,tab,Hide Create tab,Changes the existing navigation configuration. Sign in again after changing this option.,false,"[false, true]"
1,0,useractivity,Allow Apple Handoff,Keep the server setting for Apple device Handoff. Disable to turn sharing off; sign in again after changing this option.,true,"[true, false]"
