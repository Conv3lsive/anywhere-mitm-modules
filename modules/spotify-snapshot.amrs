# Experimental Spotify Premium playback flags with an optional fixed playback configuration and feed ad filtering.
# Self-contained scripts; no remote JavaScript downloads.
name = Spotify Snapshot Trial
hostname = spclient.wg.spotify.com, spotify.com

[Rule]
0,2,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/user-customization-service/v1/customize(?:\?|$),If-None-Match
# Source: scripts/spotify-snapshot-services.js
0,100,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(?:(?:gabo-receiver-service|pendragon|pam-view-service)(?:[/?]|$)|[^#]*37i9dQZF1EYkqdzj48dyYq),
# Source: scripts/spotify-snapshot.js
1,100,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(?:bootstrap/v1/bootstrap|user-customization-service/v1/customize)(?:\?|$),
# Source: scripts/spotify-snapshot-feeds.js
1,100,^https://(spclient\.wg\.spotify\.com|[\w.-]+-spclient\.spotify\.com)(?::443)?/(?:browsita/v\d+/browse|casita/v\d+/home/default|scrollsita/v\d+/scroll/spotify)(?:[/?]|$),

[Parameter]
1,0,applyRewrites,Apply module changes,"Turn off to compare HTTPS interception with account, service, and feed changes disabled. Cache-validator removal remains active.",true,"[true, false]"
1,0,replaceConfiguration,Replace playback configuration,Use the fixed configuration snapshot. Turn off to compare account flags alone; sign in again after changing this option.,true,"[true, false]"
1,0,filterFeedAds,Filter feed advertisements,"Optional structural filtering for supported search, home, and scroll responses. Disabled for the first playback test.",false,"[false, true]"
