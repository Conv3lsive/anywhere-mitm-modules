[
  {
    "id": "youtube",
    "name": "YouTube Ad Block & Playback",
    "description": "Removes supported ad placements and enables picture-in-picture and background playback flags.",
    "hostnames": [
      "youtubei.googleapis.com",
      "www.youtube.com",
      "s.youtube.com",
      "googlevideo.com"
    ],
    "rules": [
      [
        0,
        0,
        "^https?://((?!redirector)[\\w-]+\\.googlevideo\\.com)/((?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+)",
        1,
        "https://$1/$2$3$4"
      ],
      [
        0,
        0,
        "^https?://(?!redirector)[\\w-]+\\.googlevideo\\.com/(?!(?:dclk_video_ads|videoplayback\\?)).+&oad",
        2,
        ""
      ],
      [
        0,
        0,
        "^https?://(?:www|s)\\.youtube\\.com/api/stats/ads(?:[/?]|$)",
        2,
        ""
      ],
      [
        0,
        0,
        "^https?://(?:www|s)\\.youtube\\.com/(?:pagead|ptracking)(?:[/?]|$)",
        2,
        ""
      ],
      [
        0,
        0,
        "^https?://s\\.youtube\\.com/api/stats/qoe\\?adcontext",
        2,
        ""
      ],
      {
        "phase": 1,
        "pattern": "^https://youtubei\\.googleapis\\.com/youtubei/v1/(?:browse|next|player|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch)(?:\\?|$)",
        "scripts": [
          "scripts/vendor/youtube-core.js",
          "scripts/youtube.js"
        ]
      }
    ],
    "parameters": [
      [
        1,
        0,
        "blockUpload",
        "Hide upload button",
        "Hide the upload tab in supported navigation responses.",
        "true",
        "[true, false]"
      ],
      [
        1,
        0,
        "blockImmersive",
        "Hide immersive tab",
        "Hide the immersive music tab in supported navigation responses.",
        "true",
        "[true, false]"
      ],
      [
        1,
        0,
        "blockShorts",
        "Hide Shorts tab",
        "Hide the Shorts tab in supported navigation responses.",
        "false",
        "[false, true]"
      ]
    ]
  },
  {
    "id": "spotify",
    "name": "Spotify Premium",
    "description": "Sets Premium playback attributes, removes trial restrictions, and applies a fixed playback configuration with optional feed ad filtering.",
    "hostnames": [
      "spclient.wg.spotify.com",
      "spotify.com"
    ],
    "rules": [
      [
        0,
        2,
        "^https://(spclient\\.wg\\.spotify\\.com|[\\w.-]+-spclient\\.spotify\\.com)(?::443)?/user-customization-service/v1/customize(?:\\?|$)",
        "If-None-Match"
      ],
      {
        "phase": 0,
        "pattern": "^https://(spclient\\.wg\\.spotify\\.com|[\\w.-]+-spclient\\.spotify\\.com)(?::443)?/(?:(?:gabo-receiver-service|pendragon|pam-view-service)(?:[/?]|$)|[^#]*37i9dQZF1EYkqdzj48dyYq)",
        "scripts": [
          "scripts/spotify-services.js"
        ]
      },
      {
        "phase": 1,
        "pattern": "^https://(spclient\\.wg\\.spotify\\.com|[\\w.-]+-spclient\\.spotify\\.com)(?::443)?/(?:bootstrap/v1/bootstrap|user-customization-service/v1/customize)(?:\\?|$)",
        "scripts": [
          "scripts/spotify-premium.js"
        ],
        "bindings": {
          "AML_CONFIG_DATA": "data/spotify-amlabort-config.json"
        }
      },
      {
        "phase": 1,
        "pattern": "^https://(spclient\\.wg\\.spotify\\.com|[\\w.-]+-spclient\\.spotify\\.com)(?::443)?/(?:browsita/v\\d+/browse|casita/v\\d+/home/default|scrollsita/v\\d+/scroll/spotify)(?:[/?]|$)",
        "scripts": [
          "scripts/spotify-feeds.js"
        ]
      }
    ],
    "parameters": [
      [
        1,
        0,
        "applyRewrites",
        "Apply module changes",
        "Turn off to compare HTTPS interception with account, service, and feed changes disabled. Cache-validator removal remains active.",
        "true",
        "[true, false]"
      ],
      [
        1,
        0,
        "replaceConfiguration",
        "Replace playback configuration",
        "Use the fixed configuration snapshot. Turn off to compare account flags alone; sign in again after changing this option.",
        "true",
        "[true, false]"
      ],
      [
        1,
        0,
        "filterFeedAds",
        "Filter feed advertisements",
        "Optional structural filtering for supported search, home, and scroll responses. Disabled for the first playback test.",
        "false",
        "[false, true]"
      ]
    ]
  },
  {
    "id": "soundcloud",
    "name": "SoundCloud Go+ Configuration",
    "description": "Sets local Go+ plan and playback feature flags in the iOS configuration response.",
    "hostnames": [
      "api-mobile.soundcloud.com"
    ],
    "rules": [
      {
        "phase": 1,
        "pattern": "^https://api-mobile\\.soundcloud\\.com/configuration/ios(?:\\?|$)",
        "scripts": [
          "scripts/soundcloud.js"
        ]
      }
    ],
    "parameters": []
  },
  {
    "id": "reddit",
    "name": "Reddit Ad Block",
    "description": "Removes supported Reddit feed and comment ads, with an optional NSFW prompt setting.",
    "hostnames": [
      "gql.reddit.com",
      "gql-fed.reddit.com"
    ],
    "icons": {
      "light": "assets/reddit.png"
    },
    "rules": [
      {
        "phase": 1,
        "pattern": "^https?://gql(?:-fed)?\\.reddit\\.com(?:[/:?]|$)",
        "scripts": [
          "scripts/reddit.js"
        ]
      }
    ],
    "parameters": [
      [
        1,
        0,
        "disable_nsfw_prompt",
        "Disable NSFW prompts",
        "Suppress supported sensitive-content flags. Turn off to retain Reddit defaults.",
        "true",
        "[true, false]"
      ]
    ]
  }
]
